{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DAGManifestV2",
  "description": "Formally Verified DAG Manifest Specification with Bernstein Concurrency Sets, Typed Contracts, and Operationalized Personas",
  "type": "object",
  "required": ["session_id", "task_moniker", "graph_version", "nodes"],
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}_[a-zA-Z0-9_-]+$"
    },
    "task_moniker": {
      "type": "string",
      "minLength": 2
    },
    "graph_version": {
      "type": "integer",
      "minimum": 2
    },
    "created_at": {
      "type": "string"
    },
    "formal_verification_summary": {
      "type": "object",
      "properties": {
        "is_acyclic": { "type": "boolean" },
        "critical_path_depth": { "type": "integer" },
        "total_work_units": { "type": "integer" },
        "parallel_execution_waves": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "bernstein_concurrency_verified": { "type": "boolean" }
      }
    },
    "input_clarification": {
      "type": "object",
      "description": "Phase 1.5 Layered Socratic Input Clarification Gate Tracking",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PENDING", "IN_PROGRESS", "RESOLVED", "CLEAN_PASS"]
        },
        "total_questions": { "type": "integer", "minimum": 0 },
        "resolved_questions": { "type": "integer", "minimum": 0 },
        "completed_at": { "type": ["string", "null"] },
        "dialogues_file": { "type": "string" }
      }
    },
    "invalidated_assumptions": {
      "type": "array",
      "description": "Execution-Phase Dynamic Discovery Invalidation Registry with Mandatory Human Gate",
      "items": {
        "type": "object",
        "required": ["invalidation_id", "unit_id", "assumption_summary", "status", "human_gate_status"],
        "properties": {
          "invalidation_id": { "type": "string" },
          "unit_id": { "type": "string" },
          "assumption_summary": { "type": "string" },
          "discovery_evidence": { "type": ["string", "null"] },
          "status": {
            "type": "string",
            "enum": ["ACTIVE_BLOCKER", "RESOLVED", "WAIVED"]
          },
          "human_gate_status": {
            "type": "string",
            "enum": ["PENDING_HUMAN_DIALOGUE", "RESOLVED_BY_HUMAN"]
          },
          "dialogue_id": { "type": ["string", "null"] },
          "resolution_summary": { "type": ["string", "null"] },
          "resolved_at": { "type": ["string", "null"] }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "status",
          "tier",
          "assigned_maker_persona",
          "checker_personas",
          "dependencies",
          "inputs",
          "expected_outputs",
          "frame_conditions",
          "iteration_count",
          "max_iterations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AWU-[0-9]{3}([-_][a-zA-Z0-9_-]+)?$"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "tier": {
            "type": "string",
            "enum": ["standard", "architectural", "security_critical", "algorithmic"]
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "IN_PROGRESS", "COMPLETED", "FAILED", "BLOCKED", "ESCALATED"]
          },
          "assigned_maker_persona": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["persona_id"],
                "properties": {
                  "persona_id": { "type": "string" },
                  "display_name": { "type": "string" },
                  "model_tier": { "type": "string" },
                  "epistemic_stance": { 
                    "type": "string",
                    "enum": ["constructive_synthesis", "algorithmic_precision", "systems_minimalism"]
                  }
                }
              }
            ]
          },
          "checker_personas": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "required": ["persona_id"],
                  "properties": {
                    "panelist_role": { 
                      "type": "string",
                      "enum": ["Panelist1_Correctness", "Panelist2_Security", "Panelist3_SystemicSentinel"]
                    },
                    "persona_id": { "type": "string" },
                    "model_tier": { "type": "string" },
                    "epistemic_stance": {
                      "type": "string",
                      "enum": ["hostile_falsification", "adversarial_exploit", "macro_sentinel"]
                    }
                  }
                }
              ]
            }
          },
          "waivers": {
            "type": "array",
            "description": "Cryptographically signed architectural waivers for non-blocking Sev-2 defects",
            "items": {
              "type": "object",
              "required": ["architect_id", "mitigation_rationale", "signature"],
              "properties": {
                "waiver_id": { "type": "string" },
                "defect_id": { "type": "string" },
                "awu_id": { "type": "string" },
                "architect_id": { "type": "string" },
                "mitigation_rationale": { "type": "string" },
                "expiration_epoch": { "type": "number" },
                "signature": { "type": "string" }
              }
            }
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "inputs": {
            "description": "Read-Set R_u: All files, schemas, and assets read by this unit",
            "type": "array",
            "items": { "type": "string" }
          },
          "expected_outputs": {
            "description": "Declared Output Artifacts: Deliverables guaranteed upon completion",
            "type": "array",
            "items": { "type": "string" }
          },
          "frame_conditions": {
            "description": "Formal Frame Boundaries (Modifies Sets)",
            "type": "object",
            "required": ["modifies"],
            "properties": {
              "modifies": {
                "description": "Write-Set W_u: Strict list of file glob patterns permitted to be written or modified",
                "type": "array",
                "items": { "type": "string" }
              },
              "immutable": {
                "description": "Strict list of paths explicitly forbidden from mutation",
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "contracts": {
            "type": "object",
            "properties": {
              "pre_conditions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "description", "predicate"],
                  "properties": {
                    "id": { "type": "string" },
                    "description": { "type": "string" },
                    "predicate": { "type": "string" }
                  }
                }
              },
              "post_conditions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "description", "predicate"],
                  "properties": {
                    "id": { "type": "string" },
                    "description": { "type": "string" },
                    "predicate": { "type": "string" }
                  }
                }
              },
              "invariants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "description", "predicate"],
                  "properties": {
                    "id": { "type": "string" },
                    "description": { "type": "string" },
                    "predicate": { "type": "string" }
                  }
                }
              }
            }
          },
          "parallel_safe_peers": {
            "description": "Topologically independent peers satisfying Bernstein's Non-Interference Conditions",
            "type": "array",
            "items": { "type": "string" }
          },
          "iteration_count": {
            "type": "integer",
            "minimum": 0
          },
          "max_iterations": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "self_learning_loop": {
            "type": "object",
            "properties": {
              "iteration": { "type": "integer" },
              "max_iterations": { "type": "integer" },
              "learnings_file": { "type": "string" },
              "negative_constraints": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "panel_adjudication": {
            "type": "object",
            "properties": {
              "verdict": { 
                "type": "string",
                "enum": ["PASS", "PASS_WAIVED", "PASS_WITH_CAVEAT", "REJECT", "REJECT_VETO", "REJECT_MAJORITY", "PENDING"]
              },
              "highest_severity": { 
                "type": "string",
                "enum": ["None", "Sev-1", "Sev-2", "Sev-3"]
              },
              "severity_override": { "type": "boolean" },
              "adjudicated_at": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
