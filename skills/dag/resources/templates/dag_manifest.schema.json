{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DAGManifest",
  "type": "object",
  "required": ["session_id", "task_moniker", "graph_version", "nodes"],
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}_[a-zA-Z0-9_-]+$"
    },
    "task_moniker": {
      "type": "string",
      "minLength": 2
    },
    "graph_version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "status",
          "assigned_maker_persona",
          "checker_personas",
          "dependencies",
          "inputs",
          "expected_outputs",
          "iteration_count",
          "max_iterations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AWU-[0-9]{3}([-_][a-zA-Z0-9_-]+)?$"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "IN_PROGRESS", "COMPLETED", "FAILED", "BLOCKED"]
          },
          "assigned_maker_persona": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["persona_id"],
                "properties": {
                  "persona_id": { "type": "string" },
                  "display_name": { "type": "string" },
                  "model_tier": { "type": "string" },
                  "epistemic_stance": {
                    "type": "string",
                    "enum": ["constructive_synthesis", "algorithmic_precision", "systems_minimalism"]
                  }
                }
              }
            ]
          },
          "checker_personas": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "required": ["persona_id"],
                  "properties": {
                    "panelist_role": {
                      "type": "string",
                      "enum": ["Panelist1_Correctness", "Panelist2_Security", "Panelist3_SystemicSentinel"]
                    },
                    "persona_id": { "type": "string" },
                    "model_tier": { "type": "string" },
                    "epistemic_stance": {
                      "type": "string",
                      "enum": ["hostile_falsification", "adversarial_exploit", "macro_sentinel"]
                    }
                  }
                }
              ]
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "iteration_count": {
            "type": "integer",
            "minimum": 0
          },
          "max_iterations": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "self_learning_loop": {
            "type": "object",
            "properties": {
              "iteration": { "type": "integer" },
              "max_iterations": { "type": "integer" },
              "learnings_file": { "type": "string" },
              "negative_constraints": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "panel_adjudication": {
            "type": "object",
            "properties": {
              "verdict": { "type": "string" },
              "highest_severity": { "type": "string" },
              "severity_override": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
